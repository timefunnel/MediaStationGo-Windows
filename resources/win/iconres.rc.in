#include <winver.h>

IDI_ICON1 ICON "@ICON_PATH@"
1 24 "@MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
PRODUCTVERSION  @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       @APP_VERSION_FILEFLAGS@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MediaStationGo"
            VALUE "FileDescription",  "MediaStationGo Windows Player"
            VALUE "FileVersion",      "@APP_VERSION_FULL@"
            VALUE "InternalName",     "jellium-desktop"
            VALUE "OriginalFilename", "jellium-desktop.exe"
            VALUE "ProductName",      "MediaStationGo"
            VALUE "ProductVersion",   "@APP_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

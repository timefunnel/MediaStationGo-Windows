 MPV_EXPORT int mpv_initialize(mpv_handle *ctx);
 
+/**
+ * Return the D3D11 device and immediate context used by the current VO.
+ *
+ * This is a MediaStationGo extension used to bind external GPU work to the
+ * same D3D11 device as libmpv. On success both returned interfaces carry an
+ * additional COM reference and must be released with
+ * mpv_release_d3d11_device(). The function may request lazy D3D11 hwdec
+ * initialization when the current VO supports it.
+ *
+ * @return 0 on success, or a negative mpv error code when the current VO does
+ *         not expose a D3D11 device.
+ */
+MPV_EXPORT int mpv_get_d3d11_device(mpv_handle *ctx, void **device,
+                                    void **context);
+
+/** Release interfaces returned by mpv_get_d3d11_device(). */
+MPV_EXPORT void mpv_release_d3d11_device(void *device, void *context);
+
 /**
  * Disconnect and destroy the mpv_handle. ctx will be deallocated with this
  * API call.
diff --git a/player/client.c b/player/client.c
index 61c998d..8c98118 100644
--- a/player/client.c
+++ b/player/client.c
@@ -46,6 +46,13 @@
 #include "command.h"
 #include "core.h"
 #include "client.h"
+#if HAVE_D3D_HWACCEL
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_d3d11va.h>
+#include "video/hwdec.h"
+#include "video/img_format.h"
+#include "video/out/vo.h"
+#endif
 
 /*
  * Locking hierarchy:
@@ -1065,6 +1072,78 @@ static void run_locked(mpv_handle *ctx, void (*fn)(void *fn_data), void *fn_data
     mp_dispatch_unlock(ctx->mpctx->dispatch);
 }
 
+struct d3d11_device_request {
+    struct MPContext *mpctx;
+    void **device;
+    void **context;
+    int status;
+};
+
+static void get_d3d11_device_fn(void *arg)
+{
+    struct d3d11_device_request *req = arg;
+    req->status = MPV_ERROR_NOT_IMPLEMENTED;
+#if HAVE_D3D_HWACCEL
+    struct vo *vo = req->mpctx->video_out;
+    if (!vo || !vo->hwdec_devs)
+        return;
+
+    struct hwdec_imgfmt_request params = {
+        .imgfmt = IMGFMT_D3D11,
+        .probing = false,
+    };
+    hwdec_devices_request_for_img_fmt(vo->hwdec_devs, &params);
+    struct mp_hwdec_ctx *hwctx = hwdec_devices_get_by_imgfmt_and_type(
+        vo->hwdec_devs, IMGFMT_D3D11, AV_HWDEVICE_TYPE_D3D11VA);
+    AVHWDeviceContext *av_device = hwctx && hwctx->av_device_ref
+        ? (AVHWDeviceContext *)hwctx->av_device_ref->data : NULL;
+    AVD3D11VADeviceContext *d3d = av_device ? av_device->hwctx : NULL;
+    if (!d3d || !d3d->device || !d3d->device_context)
+        return;
+
+    ID3D11Device_AddRef(d3d->device);
+    ID3D11DeviceContext_AddRef(d3d->device_context);
+    *req->device = d3d->device;
+    *req->context = d3d->device_context;
+    req->status = 0;
+#endif
+}
+
+int mpv_get_d3d11_device(mpv_handle *ctx, void **device, void **context)
+{
+    if (!ctx || !device || !context)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *device = NULL;
+    *context = NULL;
+    if (!ctx->mpctx->initialized)
+        return MPV_ERROR_UNINITIALIZED;
+    struct d3d11_device_request req = {
+        .mpctx = ctx->mpctx,
+        .device = device,
+        .context = context,
+        .status = MPV_ERROR_NOT_IMPLEMENTED,
+    };
+    run_locked(ctx, get_d3d11_device_fn, &req);
+    if (req.status < 0) {
+        *device = NULL;
+        *context = NULL;
+    }
+    return req.status;
+}
+
+void mpv_release_d3d11_device(void *device, void *context)
+{
+#if HAVE_D3D_HWACCEL
+    if (context)
+        ID3D11DeviceContext_Release((ID3D11DeviceContext *)context);
+    if (device)
+        ID3D11Device_Release((ID3D11Device *)device);
+#else
+    (void)device;
+    (void)context;
+#endif
+}
+
 // Run a command asynchronously. It's the responsibility of the caller to
 // actually send the reply. This helper merely saves a small part of the
 // required boilerplate to do so.

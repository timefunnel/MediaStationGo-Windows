<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>MediaStationGo Rust third-party licenses</title>
  <style>
    body { font-family: sans-serif; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
    pre { border: 1px solid #ccc; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>MediaStationGo Rust third-party licenses</h1>
  <p>This file was generated from the locked Windows x64 dependency graph.</p>
  {{#each licenses}}
    {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
    <h3>{{name}}</h3>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
